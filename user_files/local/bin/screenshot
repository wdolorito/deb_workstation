#!/bin/sh

#
# ~/local/bin/screenshot
#

GRIM="$(which grim 2>/dev/null)"
SLURP="$(which slurp 2>/dev/null)"
SSDIR="$HOME/Pictures/screenshot"

if [ "$XDG_SESSION_TYPE" = "tty" ] || [ -z "$XDG_SESSION_TYPE" ]
then
	echo "Not in a graphical session."
	exit 1
fi


if [ -n "$GRIM" ]
then
	if ! [ -d "$SSDIR" ]
	then
		mkdir -p "$SSDIR"
	fi

	if [ -z "$1" ]
	then
		$GRIM "$SSDIR/screen-$(date '+%F_%T').png"
	else
		if [ -z "$SLURP" ]
		then
			echo "slurp command not available."
			exit 127
		fi

		$SLURP | $GRIM -g - "$SSDIR/crop-$(date '+%F_%T').png"
	fi
else
	echo "grim command not available."
	exit 127
fi
